---
import Footer from '@astrojs/starlight/components/Footer.astro';
import { sources } from '../../navigation.mjs';

const id = Astro.locals.starlightRoute.entry.id || 'index';
const file = Object.entries(sources).find(([, source]) => source.id === id)?.[0];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="page-actions print:hidden">
  {file && <a href={`${base}/_sources/${file}`} download>Download MyST source</a>}
  <button type="button" data-print-page>Print / save PDF</button>
  <a href="https://gitlab.kwant-project.org/qt/pymablock/-/issues">Report an issue</a>
</div>
<Footer />
<script>
  document.addEventListener('click', event => {
    if ((event.target as Element).closest('[data-print-page]')) window.print();
  });
</script>
<style>
  .page-actions { display:flex; flex-wrap:wrap; gap:1rem; margin-top:2rem; font-size:var(--sl-text-sm); }
  button { border:0; padding:0; background:none; color:var(--sl-color-text-accent); font:inherit; cursor:pointer; text-decoration:underline; }
</style>
